# ==========================================================================
# Copia este archivo a .env y REEMPLAZA todos los valores "cambiar_*".
# El backend se niega a arrancar si detecta los valores de ejemplo.
# ==========================================================================

# Configuracion del servidor
PORT=3000

# Configuracion de la base de datos MariaDB
DATABASE_HOST=mariadb
DATABASE_NAME=residencias
DATABASE_USER=residencias_usuario
DATABASE_PASSWORD=cambiar_contraseña_segura
DATABASE_PORT=3306

# Contraseña root de MariaDB (solo para docker-compose)
MARIADB_ROOT_PASSWORD=cambiar_root_password

# Autenticacion JWT
# Generar con:  openssl rand -hex 32     (minimo 32 caracteres)
JWT_SECRET=cambiar_secreto_jwt_seguro
ACCESS_TOKEN_EXPIRATION=90m
REFRESH_TOKEN_EXPIRATION_DAYS=7

# API Key (opcional). Si se define, se exige la cabecera 'api-key' en todas
# las rutas protegidas, ademas del JWT.
# No se pasa por docker-compose: si la quieres en el despliegue con docker,
# agrega API_KEY al bloque environment del servicio backend.
# API_KEY=

# Origenes permitidos para CORS, separados por coma.
# Dejar VACIO en el despliegue con docker: nginx sirve el frontend y hace
# proxy de /api/, asi que todo es el mismo origen.
# Para desarrollo local con vite:  CORS_ORIGIN=http://localhost:5173
CORS_ORIGIN=

# ==========================================================================
# Inicializacion automatica de la base de datos
# --------------------------------------------------------------------------
# Al arrancar, el backend crea (si faltan): el catalogo de modulos y permisos,
# el rol de superusuario con todos los permisos, el superusuario, y los dos
# semestres del año en curso ("Enero - Junio AAAA" y "Agosto - Diciembre AAAA").
# Es idempotente y NO sobrescribe la contraseña de un superusuario existente.
# Los semestres mas antiguos se agregan a mano desde la pantalla "Semestres".
# ==========================================================================
BOOTSTRAP_ENABLED=true
SUPERUSER_USER=superusuario
SUPERUSER_EMAIL=admin@ejemplo.com
# Generar con:  openssl rand -base64 24    (minimo 12 caracteres)
SUPERUSER_PASSWORD=cambiar_password_superusuario
SUPERUSER_ROLE_NAME=Superusuario

# Configuracion del frontend
VITE_API_URL=/api
