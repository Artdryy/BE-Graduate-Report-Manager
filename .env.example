# Configuracion del servidor
PORT=3000

# Configuracion de la base de datos MariaDB
DATABASE_HOST=mariadb
DATABASE_NAME=residencias
DATABASE_USER=residencias_usuario
DATABASE_PASSWORD=cambiar_contraseña_segura
DATABASE_PORT=3306

# Contraseña root de MariaDB (solo para docker-compose)
MARIADB_ROOT_PASSWORD=cambiar_root_password

# Autenticacion JWT
JWT_SECRET=cambiar_secreto_jwt_seguro
ACCESS_TOKEN_EXPIRATION=90m
REFRESH_TOKEN_EXPIRATION_DAYS=7

# API Key (opcional)
# API_KEY=

# Configuracion del frontend
VITE_API_URL=/api
